# --- Server ---
PORT=3000

# Where the SQLite file lives. Resolution order:
# RAILWAY_VOLUME_MOUNT_PATH -> DATA_DIR -> ./data.
#
# ON RAILWAY THIS MUST BE A VOLUME. Without one, every redeploy throws away
# the 12-month backfill AND the observed-reschedule history, which cannot be
# re-derived from Ashby (see README § Reschedules).
DATA_DIR=./data

# HTTP Basic Auth in front of every route except /healthz. One shared
# credential: everyone who can log in sees every client's tab.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

DASHBOARD_TITLE=Coordinator Metrics

# --- Clients ---
# Comma-separated client ids. Each one needs its own suffixed variables
# below, where the suffix is the id uppercased (forus -> FORUS).
CLIENTS=january,forus,luminai,poetic,runlayer

# Per client. Only ASHBY_API_KEY_* is required; the rest have defaults.
#
#   ASHBY_API_KEY_<ID>              that client's Ashby key (Admin > Integrations > API Keys)
#   CLIENT_NAME_<ID>                display name on the tab, defaults to the capitalised id
#   CLIENT_TIMEZONE_<ID>            IANA name, defaults to America/New_York
#   CLIENT_ACCENT_COLOR_<ID>        any CSS color, tints that client's tab.
#                                   QUOTE a hex value in this file — dotenv reads
#                                   an unquoted #1d3efc as a comment and the tab
#                                   silently loses its colour. Railway variables
#                                   are not parsed by dotenv, so no quotes there.
#   EXCLUDED_TITLE_KEYWORDS_<ID>    see § Counting rules below
#
# MUST be an IANA name, not a fixed abbreviation: Node silently resolves
# "EST" to America/Panama, which never observes daylight saving and so reads
# an hour out for roughly eight months a year. Use "America/New_York".
ASHBY_API_KEY_JANUARY=
CLIENT_NAME_JANUARY=January
CLIENT_TIMEZONE_JANUARY=America/New_York

ASHBY_API_KEY_FORUS=
CLIENT_NAME_FORUS=Forus
CLIENT_TIMEZONE_FORUS=America/New_York

ASHBY_API_KEY_LUMINAI=
CLIENT_NAME_LUMINAI=Luminai
CLIENT_TIMEZONE_LUMINAI=America/Los_Angeles

ASHBY_API_KEY_POETIC=
CLIENT_NAME_POETIC=Poetic
CLIENT_TIMEZONE_POETIC=America/Los_Angeles

ASHBY_API_KEY_RUNLAYER=
CLIENT_NAME_RUNLAYER=Runlayer
CLIENT_TIMEZONE_RUNLAYER=America/New_York

# Zone the cross-client overview tab buckets days and weeks in. Per-client
# tabs ignore this and use their own zone.
OVERVIEW_TIMEZONE=America/New_York

# --- Counting rules ---
# What counts as a unit of scheduling volume: candidate-facing interview
# events AND debriefs; holds, logistics and internal blocks excluded.
#
# Debriefs are identified by Ashby's own structured `isDebrief` flag, so they
# need no configuration. Holds are NOT structured anywhere in Ashby, so they
# are matched on interview-title keywords, which differ per org — Forus's
# live interview.list contains "External Hold", "[Forus] Arrival + Set Up",
# "... Work Time" and "Dinner with Forus" alongside real interviews.
#
# Run `npm run check-client -- --client=<id>` against a new client to see
# their real interview titles before trusting the defaults. Set an empty
# value to exclude nothing for that client.
# Note "lunch"/"dinner" are deliberately absent: a candidate meal is
# coordinated candidate time (Forus's 469 are all on a named candidate's
# application, 463 in an Onsite stage, median two interviewers), so meals
# are COUNTED and reported as a named sub-count instead.
# EXCLUDED_TITLE_KEYWORDS_FORUS=hold,work time,arrival,set up,setup,break,buffer,placeholder

# Job records that are scaffolding rather than real reqs. Matched against
# the job title TRIMMED AND LOWERCASED, IN FULL — an exact match, never a
# substring, so a genuine "Test Engineer" role is never caught by accident.
# Confirmed real: Luminai has three job records titled "TEST" and Runlayer
# had a "TEST PIPELINE" req with two interview events on it.
# Default: test,test pipeline,testing,do not use
# EXCLUDED_JOB_TITLES_RUNLAYER=test,test pipeline,testing,do not use

# --- Carrara coordinator roster ---
# Whose scheduling counts as our work, for the Carrara-coordinated scope.
#
# Matched against the scheduler name Ashby stores ON THE SCHEDULE, not
# against user ids: user.list is incomplete (it omits the accounts behind
# 1,789 of January's scheduled events and 1,323 of Forus's), but the name
# is on every schedule regardless.
#
# Matching is EXACT on the normalised full name, never a substring —
# "Anna Jones" as a substring also matches "Giovanna Borgiotti" and
# "Hanna Rocks", who are different people.
#
# Include coordinators who have left: their work still counts. Add both
# spellings for anyone whose name differs between accounts.
# CARRARA_COORDINATORS=Tess Wicks,Theresa Wicks,Kelley Lantigua,...
# Per-client override, defaults to the shared list above:
# CARRARA_COORDINATORS_FORUS=Anna Jones,Maggie Stout

# --- Sync ---
# How much history the nightly full sync pulls. 12 months of a busy client
# is ~21,000 schedules and takes about three minutes of Ashby pagination,
# so raising this has a real cost.
HISTORY_MONTHS=12

# The hourly top-up re-reads only schedules CREATED in this window. Ashby's
# interviewSchedule.list has createdAfter but no updatedAfter, so an older
# schedule that changes today is only picked up by the next full sync.
# Widen this if that lag matters more than sync speed.
INCREMENTAL_DAYS=60

# Hour (server local time, 0-23) the nightly full sync runs.
FULL_SYNC_HOUR=3
# Minutes between top-ups.
INCREMENTAL_MINUTES=60
# Run a top-up as soon as the process starts. Set false to skip it.
SYNC_ON_BOOT=true
# How many clients sync at once. Each is a separate Ashby org with its own
# rate limit, so parallelism across clients is safe.
CLIENT_CONCURRENCY=2

# --- Metric thresholds ---
# A slot booked less than this many hours before it starts counts as
# short-notice — the firefighting signal a raw volume count hides.
SHORT_NOTICE_HOURS=24
# Local business hours, in each client's own zone. An event starting
# outside these counts as out-of-hours.
BUSINESS_HOUR_START=8
BUSINESS_HOUR_END=18
