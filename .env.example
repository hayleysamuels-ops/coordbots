# Copy to .env and fill in. Never commit .env — it is gitignored.

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everybody out.
SESSION_SECRET=

# Shared Postgres. Leave blank locally to use a data.json file instead.
DATABASE_URL=

# Optional — defaults to 3000.
PORT=

# ---- Bots (optional) ----
# The tracker runs fine without these; the bots stay idle and say so in the UI.

# Ashby API key. READ-ONLY key — the client refuses any endpoint that is not a read.
ASHBY_READ_KEY=

# Bot token (xoxb-...) for the "Work Trial Bots" Slack app. Needs chat:write.
SLACK_BOT_TOKEN=

# Channel the reports post to. C0AU1FFSU2H is #poetic-rc-team.
SLACK_CHANNEL_ID=

# Google service account for reading the WT Tracker sheet (bot: sheet reconcile).
# The whole JSON key file, base64-encoded on one line:
#   base64 -i <key>.json | tr -d '\n'
# Access comes from sharing the sheet with the service account's client_email
# as Viewer — it holds no IAM role.
GOOGLE_SA_KEY_B64=

# The WT Tracker spreadsheet: the segment between /d/ and /edit in its URL.
POETIC_SHEET_ID=

# ---- Declines rail and declines-watch bot ----
# A SECOND Google service account, separate from GOOGLE_SA_KEY_B64 by design:
# that one reads the spreadsheet, this one reads the Poetic Interviews calendar.
# Same encoding. The calendar must be shared with its client_email at
# "See all event details" — "See free/busy information only" strips the
# attendee list entirely and every decline silently disappears.
GOOGLE_CAL_SA_KEY_B64=

# The Poetic Interviews calendar id (the long ...@group.calendar.google.com).
POETIC_CALENDAR_ID=

# Public base URL, used to build tracker deep links in Slack messages
# (e.g. https://work-trial-tracker-production.up.railway.app). Optional:
# without it the declines bot posts candidate names without links.
TRACKER_BASE_URL=

# Scheduling connection. Leave unset until the separate worker is deployed.
ASHBY_WORKER_URL=
# Same random secret (at least 32 characters) on tracker and worker.
ASHBY_WORKER_SECRET=
# Worker only: independent 32-byte encryption key, 64 hex characters.
ASHBY_SESSION_KEY=
# Worker only: mount a persistent Railway volume at /data.
ASHBY_SESSION_FILE=/data/ashby/session.enc
# Worker build only; set RAILWAY_DOCKERFILE_PATH=worker/Dockerfile on that service.
# Worker only. Default keeps Chromium's sandbox enabled. Changing this to
# "container" requires explicit owner approval for the reduced browser isolation.
ASHBY_BROWSER_ISOLATION=sandbox

# Onsite discussion approvals: independent of Ashby booking approvals.
SCHEDULING_SLACK_ROUTING=candidate
SCHEDULING_CANDIDATE_CHANNELS_JSON={}
# Used only when routing is explicitly set to client.
SCHEDULING_SLACK_CHANNEL_ID=
SCHEDULING_SLACK_CHANNEL_NAME=
SCHEDULING_SLACK_BOT_TOKEN=
