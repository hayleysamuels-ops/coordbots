# --- Server ---
PORT=3000

# --- Ashby ---
# The secret token you enter when creating the webhook in Ashby
# (Admin > Integrations > Webhooks). Used to verify request signatures.
# Generate a fresh one per client: openssl rand -hex 32
ASHBY_WEBHOOK_SECRET=replace-with-your-webhook-secret

# Optional but recommended: an Ashby API key (Admin > Integrations > API Keys)
# with candidatesRead. It is what lets the bot leave a channel open when the
# candidate is still live for a second role. Without it that check is skipped.
ASHBY_API_KEY=

# Base URL of the Ashby web app, used for the profile link on the closing
# notice. Only change this for a custom domain.
ASHBY_APP_BASE_URL=https://app.ashbyhq.com

# --- Slack ---
# Bot User OAuth Token from your Slack app (starts with xoxb-).
# Required scopes: channels:read, groups:read, channels:manage, groups:write,
# chat:write, channels:join
SLACK_BOT_TOKEN=xoxb-replace-me

# --- Channel matching ---
# REQUIRED, and the bot's safety guard. The candidate channel name is this
# prefix plus the slugified candidate name, so "cand-" turns Jane Smith into
# #cand-jane-smith. The bot refuses to archive any channel whose name does not
# start with this prefix, and archives nothing at all when it is unset.
CANDIDATE_CHANNEL_PREFIX=cand-

# Channel names that carry the prefix but are NOT candidate channels, and must
# never be archived. Comma-separated; a leading # is ignored and matching is
# case-insensitive. Luminai has #hiring-nyc-event sitting in this namespace.
# Run `node scripts/dry-run.js --list` and denylist anything in the output that
# is not somebody's candidate channel.
CHANNEL_DENYLIST=

# --- Behaviour ---
# Which outcomes close a channel. Comma-separated: archived, hired.
# Drop "hired" to keep hired candidates' channels open for onboarding handoff.
ARCHIVE_ON=archived,hired

# Default true, so a first deploy logs what it would archive and touches
# nothing. Watch the logs through a few real outcomes, then set it to false.
DRY_RUN=true

# Post a short closing message naming the outcome before archiving, so the
# channel history ends with context.
POST_CLOSING_NOTICE=true

# Leave the channel open while the candidate has another Active or Lead
# application. Needs ASHBY_API_KEY. When the lookup fails the bot proceeds and
# logs a warning.
REQUIRE_ALL_APPLICATIONS_CLOSED=true

# Join a public candidate channel the bot is not in, so it can post the notice.
# Private channels must have the bot invited by hand.
AUTO_JOIN_PUBLIC=true

# How long to reuse the channel list before re-reading it from Slack.
CHANNEL_CACHE_TTL_MINUTES=10

# Optional: channel ID for warnings when an archive fails (e.g. recruiting ops).
FALLBACK_SLACK_CHANNEL=

# Set to "true" to log full raw webhook payloads while wiring this up.
DEBUG_PAYLOADS=false

# Optional: directory for the record of handled events. Defaults to ./data.
# On Railway, point this at a mounted volume so it survives redeploys.
# DATA_DIR=/data
