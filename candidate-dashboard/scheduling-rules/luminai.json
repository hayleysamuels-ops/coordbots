{
  "$schema": "./schema.json",
  "$comment": "Reproduces candidate-dashboard on feature/client-ashby-connection as of 2026-09-22, plus revision 2's assumed 9–5 Pacific meeting hours and interviewer attendance. The dashboard reads this file at runtime.",
  "schemaVersion": 2,
  "clientId": "luminai",
  "rulesRevision": 4,

  "trial": {
    "stageTitleContains": null,
    "maxDaysAfterStart": null,
    "roles": null,
    "jobTitleToRole": []
  },

  "capacity": {
    "maxConcurrentTrialsPerDay": null,
    "sameRoleSameDay": null,
    "bypassCandidateName": null
  },

  "sessions": {
    "exclusions": [],
    "placementWindows": [
      { "match": "contains", "value": "Lunch", "timezone": "America/Los_Angeles", "earliestStart": "12:00", "latestStart": "13:30", "reason": "Lunch sessions start at a lunch time in San Francisco." }
    ]
  },

  "agenda": { "singleDay": true, "minBreakMinutes": 0, "maxGapMinutes": 0 },

  "duration": {
    "fallbackMinutes": null,
    "minMinutes": 5,
    "maxMinutes": 480
  },

  "assignment": { "strategy": "fewest_in_agenda" },

  "limits": { "ashbyInterviewerLimits": "zero_only" },

  "meetingHours": {
    "$comment": "Assumed, not collected from interviewers. Luminai is San Francisco-based; the default's weekdays are an assumption too. Overrides added 2026-09-29 (revision 3). The other eight video interviewers under attendance still inherit the Pacific default, which is wrong for them; their hours are still to come.",
    "default": { "timezone": "America/Los_Angeles", "days": ["mon", "tue", "wed", "thu", "fri"], "start": "09:00", "end": "17:00" },
    "overrides": {
      "aggelos@luminai.com": { "timezone": "Europe/Athens", "days": ["mon", "tue", "wed", "thu", "fri"], "start": "19:00", "end": "22:00" },
      "alex.mavrogiannis@luminai.com": { "timezone": "Europe/Athens", "days": ["mon", "tue", "wed", "thu", "fri"], "start": "19:00", "end": "22:00" },
      "mary@luminai.com": { "timezone": "America/New_York", "days": ["mon", "tue", "wed", "thu", "fri"], "start": "09:00", "end": "17:00" }
    }
  },

  "attendance": {
    "$comment": "In person unless listed. Matched to Ashby login emails on 2026-09-29. Four more named as video (Amelia, Chris Gonzalez, Daniel Noguchi, Michael Carignan) have no active Luminai Ashby account and aren't listed.",
    "default": "in_person",
    "overrides": {
      "aggelos@luminai.com": "video",
      "alex.mavrogiannis@luminai.com": "video",
      "ali@luminai.com": "video",
      "anisha@luminai.com": "video",
      "dmitriy@luminai.com": "video",
      "harry@luminai.com": "video",
      "jen@luminai.com": "video",
      "jordan.silvergleid@luminai.com": "video",
      "sean@luminai.com": "video",
      "shawn@luminai.com": "video"
    }
  },

  "busy": {
    "source": "google_freebusy",
    "calendars": ["primary"],
    "ashbyConflictsAdvisory": true
  },

  "communications": {
    "calendarInvitesRequired": true,
    "candidateConfirmationRequired": true
  },

  "conferencing": { "allowedProviders": ["none", "google_meet", "zoom"] },

  "rooms": { "policy": "validate_if_present" },

  "approval": {
    "approvers": [
      { "kind": "username", "id": "Luminai Scheduler" }
    ],
    "allowedDomain": null
  }
}
