{
  "$schema": "./schema.json",
  "$comment": "Reproduces candidate-dashboard on feature/client-ashby-connection as of 2026-09-22, plus revision 2's assumed 9–5 Pacific meeting hours. Not yet read by any engine.",
  "schemaVersion": 2,
  "clientId": "luminai",
  "rulesRevision": 2,

  "trial": {
    "stageTitleContains": null,
    "maxDaysAfterStart": null,
    "roles": null,
    "jobTitleToRole": []
  },

  "capacity": {
    "maxConcurrentTrialsPerDay": null,
    "sameRoleSameDay": null,
    "bypassCandidateName": null
  },

  "sessions": { "exclusions": [] },

  "agenda": { "singleDay": true, "minBreakMinutes": 0, "maxGapMinutes": 0 },

  "duration": {
    "fallbackMinutes": null,
    "minMinutes": 5,
    "maxMinutes": 480
  },

  "assignment": { "strategy": "fewest_in_agenda" },

  "limits": { "ashbyInterviewerLimits": "zero_only" },

  "meetingHours": {
    "$comment": "Assumed, not collected from interviewers. Luminai is San Francisco-based; weekdays are also an assumption. Mary Petrino's 09:00–17:00 America/New_York (from the handoff) belongs in overrides once her Ashby login email is confirmed.",
    "default": { "timezone": "America/Los_Angeles", "days": ["mon", "tue", "wed", "thu", "fri"], "start": "09:00", "end": "17:00" },
    "overrides": {}
  },


  "busy": {
    "source": "google_freebusy",
    "calendars": ["primary"],
    "ashbyConflictsAdvisory": true
  },

  "communications": {
    "calendarInvitesRequired": true,
    "candidateConfirmationRequired": true
  },

  "conferencing": { "allowedProviders": ["none", "google_meet", "zoom"] },

  "rooms": { "policy": "validate_if_present" },

  "approval": {
    "approvers": [
      { "kind": "username", "id": "Luminai Scheduler" }
    ],
    "allowedDomain": null
  }
}
