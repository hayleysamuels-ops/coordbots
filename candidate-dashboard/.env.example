# --- Server ---
PORT=3000

# Directory persisted files (dismissals, self-tracked history) are written
# to. Resolution order: RAILWAY_VOLUME_MOUNT_PATH -> DATA_DIR -> ./data. On
# Railway with a volume attached, leave both unset — RAILWAY_VOLUME_MOUNT_PATH
# is set automatically. On any other host, point DATA_DIR at a mounted volume
# so this state survives redeploys.
DATA_DIR=./data

# --- Display (cosmetic, but client-specific) ---
# Single source of truth for the client this deployment is for. Drives the
# page header and browser tab title: "<CLIENT_NAME> Coordination Dashboard".
# Leave unset for a plain, unbranded "Candidate Dashboard".
CLIENT_NAME=

# Overrides the header accent color (topbar border + title text) so each
# client deployment is visually distinguishable at a glance. Any valid CSS
# color (e.g. #1a73e8). Leave unset to use the default brand ember.
CLIENT_ACCENT_COLOR=

# Comma-separated section keys (see README § Section keys) to hide from this
# client's dashboard entirely, e.g. a client that doesn't configure Ashby
# weeklyLimits has no use for Interviewer Weekly Limits
# (DISABLED_SECTIONS=interviewerLimits). Leave unset to show every section.
# An unrecognized key logs a startup warning rather than silently doing
# nothing — check the deploy logs after setting this.
DISABLED_SECTIONS=

# Recruiter/Coordinator filter: exact hiringTeamRole.list values (not a
# substring match). This org's roles are "Hiring Manager", "Recruiter",
# "Recruiting Coordinator", "Sourcer" — verify a new client's real
# hiringTeamRole.list before trusting the defaults (see
# scripts/check-ashby-compatibility.js).
RECRUITER_ROLE_NAME=Recruiter
COORDINATOR_ROLE_NAME=Recruiting Coordinator

# HTTP Basic Auth, required in front of every route (including /api/*) —
# there is no per-user auth, just one shared set of credentials for whoever
# is allowed to view the dashboard.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Ashby ---
# Admin > Integrations > API Keys. Needs read access to applications,
# interview schedules, and candidates.
ASHBY_API_KEY=

# Base URL of the Ashby web app, used to build candidate profile links.
# Only change if your org uses a custom Ashby domain.
ASHBY_APP_BASE_URL=https://app.ashbyhq.com

# --- Flag thresholds (hours) ---
# Interview event ended, feedback still not submitted.
FEEDBACK_OVERDUE_HOURS=24
# Interview schedule stuck in "NeedsScheduling" status — nothing has been
# sent to the candidate yet (no availability request, no self-schedule
# link). Distinct from AVAILABILITY_SUBMITTED_ALERT_HOURS below; see README.
NEEDS_SCHEDULING_ALERT_HOURS=48
# Color-coding threshold (not a filter) for how long a candidate's submitted
# availability has sat unbooked in "CandidateAvailabilitySubmitted" status.
AVAILABILITY_SUBMITTED_ALERT_HOURS=24

# --- Stale Candidates section ---
# Candidates this far past the thresholds above are pulled out of the two
# regular columns into their own "Stale Candidates" section.
STALE_FEEDBACK_HOURS=350
STALE_SCHEDULING_HOURS=168

# --- Interviewer Weekly Limits section ---
# An interviewer is flagged once their remaining weekly capacity (their
# Ashby-configured weeklyLimit minus interviews already on their calendar
# this week) drops to this many slots or fewer. Interviewers with no
# weeklyLimit set in Ashby are never flagged.
INTERVIEWER_LIMIT_BUFFER=1

# --- Recently Sourced section ---
# Show candidates whose application was created within this many days with a
# referral or agency source.
SOURCED_LOOKBACK_DAYS=3
# Which source.sourceType.title substrings (comma-separated, case-insensitive)
# count as a referral or an agency. EVERY ASHBY ORG NAMES THESE DIFFERENTLY —
# verify against this client's real source.list before trusting the
# defaults (see scripts/check-ashby-compatibility.js). Set to an empty value
# to disable that category entirely rather than silently matching nothing.
SOURCE_REFERRAL_KEYWORDS=referr
SOURCE_AGENCY_KEYWORDS=agenc

# --- Onsite Interviews Today section ---
# Ashby has no real onsite/location signal anywhere, so this section matches
# on interview STAGE title substrings instead (comma-separated,
# case-insensitive) — entirely dependent on this client's own stage-naming
# convention. "final,exec" (matching this org's "Final Round"/"Final Round
# (series)" and "Executive Interview" stages) was January's convention, not
# an Ashby default. Set to an empty value to disable the section entirely
# rather than silently matching nothing. Verify against this client's real
# stage titles first (see scripts/check-ashby-compatibility.js).
ONSITE_STAGE_KEYWORDS=final,exec

# How far back (days) to pull interviewSchedule.list for the schedule-driven
# sections (Feedback Overdue, Needs Scheduling, Availability Submitted,
# Interviewer Weekly Limits, Onsite Interviews Today). Tune per client's
# interview volume/velocity — see README § Scope.
SCHEDULE_LOOKBACK_DAYS=30

# --- Rescheduled Interviews section ---
# Flag an interview event once its reschedule count exceeds this many
# (default 2, i.e. the 3rd reschedule onward). Ashby has no reschedule
# history anywhere in its API — this app tracks it itself (see
# src/rescheduleTracking.js), so counting only starts from whenever this
# server first observes a given event; it can't see reschedules that
# happened before that.
RESCHEDULE_COUNT_THRESHOLD=2

# How often (minutes) the server re-pulls Ashby in the background for the
# nine sections. The dashboard itself polls /api/issues every 60s but
# only re-fetches this cached snapshot — it doesn't hit Ashby on every page
# load.
REFRESH_INTERVAL_MINUTES=5
