# --- Server ---
PORT=3000

# --- Ashby ---
# Admin > Integrations > API Keys. Needs read access to applications,
# interview schedules, and candidates.
ASHBY_API_KEY=

# Base URL of the Ashby web app, used to build candidate profile links.
# Only change if your org uses a custom Ashby domain.
ASHBY_APP_BASE_URL=https://app.ashbyhq.com

# --- Flag thresholds (hours) ---
# Interview event ended, feedback still not submitted.
FEEDBACK_OVERDUE_HOURS=24
# Interview schedule stuck in "NeedsScheduling" status — nothing has been
# sent to the candidate yet (no availability request, no self-schedule
# link). Distinct from AVAILABILITY_SUBMITTED_ALERT_HOURS below; see README.
NEEDS_SCHEDULING_ALERT_HOURS=48
# Color-coding threshold (not a filter) for how long a candidate's submitted
# availability has sat unbooked in "CandidateAvailabilitySubmitted" status.
AVAILABILITY_SUBMITTED_ALERT_HOURS=24

# --- Stale Candidates section ---
# Candidates this far past the thresholds above are pulled out of the two
# regular columns into their own "Stale Candidates" section.
STALE_FEEDBACK_HOURS=350
STALE_SCHEDULING_HOURS=168

# --- Interviewer Weekly Limits section ---
# An interviewer is flagged once their remaining weekly capacity (their
# Ashby-configured weeklyLimit minus interviews already on their calendar
# this week) drops to this many slots or fewer. Interviewers with no
# weeklyLimit set in Ashby are never flagged.
INTERVIEWER_LIMIT_BUFFER=1

# --- Recently Sourced section ---
# Show candidates whose application was created within this many days with a
# referral or agency source.
SOURCED_LOOKBACK_DAYS=3

# How often (minutes) the server re-pulls Ashby in the background for the
# six main sections. The dashboard itself polls /api/issues every 60s but
# only re-fetches this cached snapshot — it doesn't hit Ashby on every page
# load.
REFRESH_INTERVAL_MINUTES=5

# --- Active Referrals section ---
# Separate refresh timer, independent of REFRESH_INTERVAL_MINUTES above, on
# purpose — Active Referrals does a one-time full active-application scan
# (measured on this org: ~12 minutes, 31,669 applications) and then persists
# a syncToken to do incremental syncs after that (see README). Its own timer
# means its cost never delays the other six sections.
ACTIVE_REFERRALS_REFRESH_INTERVAL_MINUTES=5
