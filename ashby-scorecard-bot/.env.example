# --- Server ---
PORT=3000

# --- Ashby ---
# The secret token you enter when creating the webhook in Ashby
# (Admin > Integrations > Webhooks). Used to verify request signatures.
ASHBY_WEBHOOK_SECRET=replace-with-your-webhook-secret

# Optional but recommended: an Ashby API key (Admin > Integrations > API Keys).
# Enables three things:
#   1. "Skip if already submitted" — before reminding, the bot checks Ashby and
#      drops any interviewer who already filed their scorecard (candidatesRead).
#   2. Debrief / non-scored detection — looks up each interview to skip debriefs
#      and interviews that don't require feedback (interviewsRead).
#   3. Enriches the DM with candidate name / job title.
# Needs candidatesRead + interviewsRead. Leave blank to disable all three (the
# bot will then remind everyone for every interview, debriefs included).
ASHBY_API_KEY=

# Base URL of the Ashby web app, used to build the "Submit your scorecard" and
# "Open the interview brief" links on every DM. Only change for a custom domain.
ASHBY_APP_BASE_URL=https://app.ashbyhq.com

# --- Slack ---
# Bot User OAuth Token from your Slack app (starts with xoxb-).
# Required scopes: chat:write, users:read, users:read.email, im:write
SLACK_BOT_TOKEN=xoxb-replace-me

# --- Behaviour ---
# Minutes after the interview's scheduled end time to send the FIRST reminder.
# 0 = right at the end. 5 = five minutes after. Applies to all stages as a
# baseline offset.
REMINDER_DELAY_MINUTES=0

# Escalating reminder schedule: hours after the interview end time to send each
# reminder. Default sends at the end, follows up at 24h, and sends a final
# reminder at the 48h SLA deadline. Anyone who has already submitted their
# scorecard is skipped at each stage. Comma-separated; e.g. "0,24,48".
REMINDER_SCHEDULE_HOURS=0,24,48

# Debriefs are skipped automatically: the bot looks up each interview (needs
# ASHBY_API_KEY with interviewsRead) and skips it when Ashby marks it as a
# debrief (isDebrief) or as not requiring feedback (isFeedbackRequired = false).
# This is an ADDITIONAL safety net — extra interview names to skip, matched
# case-insensitively against the looked-up interview title. Comma-separated;
# set to empty to disable name matching. Default: debrief.
EXCLUDE_INTERVIEW_NAME_PATTERNS=debrief

# If a Slack user can't be found for an interviewer's email, optionally post
# a fallback notice to this channel ID (e.g. a recruiting ops channel).
# Leave blank to just log and skip.
FALLBACK_SLACK_CHANNEL=

# Set to "true" to log full raw webhook payloads. Useful the first time you
# wire this up so you can confirm Ashby's exact field names. Turn off in prod.
DEBUG_PAYLOADS=true

# Optional: directory to store pending reminders. Defaults to ./data. On a
# cloud host, point this at a mounted persistent volume (e.g. /data) so pending
# reminders survive restarts and redeploys.
# DATA_DIR=/data
